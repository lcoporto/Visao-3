rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- Validation Blueprints ---
    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'phone']) &&
             data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20;
    }

    function isValidPart(data) {
      return data.keys().hasAll(['name', 'sku', 'quantity']) &&
             data.name is string && data.name.size() <= 100 &&
             data.sku is string && data.sku.size() <= 50 &&
             data.quantity is int &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('price' in data) || (data.price is number));
    }

    function isValidMovement(data) {
      return data.keys().hasAll(['partId', 'userId', 'type', 'quantity', 'timestamp']) &&
             isValidId(data.partId) &&
             data.userId == request.auth.uid &&
             data.type in ['in', 'out'] &&
             data.quantity is int && data.quantity > 0 &&
             data.timestamp == request.time;
    }

    function isValidServiceOrder(data) {
      return data.keys().hasAll(['customerName', 'status']) &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.status in ['open', 'in-progress', 'completed', 'cancelled'];
    }

    // --- Rules ---

    match /parts/{partId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isVerified() && isValidPart(incoming());
      allow update: if isVerified() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'updatedAt']) && incoming().updatedAt == request.time) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidCustomer(incoming());
      allow update: if isVerified() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'address', 'updatedAt']) && incoming().updatedAt == request.time) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /movements/{movementId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // In a real app, maybe only see your own or admin
      allow create: if isVerified() && isValidMovement(incoming()) && exists(/databases/$(database)/documents/parts/$(incoming().partId));
    }

    match /serviceOrders/{osId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidServiceOrder(incoming());
      allow update: if isVerified() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'parts', 'laborCost', 'totalCost', 'updatedAt']) && incoming().updatedAt == request.time) ||
        isAdmin()
      );
    }

    match /appointments/{appointmentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isVerified() && incoming().keys().hasAll(['customerName', 'dateTime', 'status']);
      allow update: if isVerified();
      allow delete: if isVerified();
    }
    
    match /admins/{userId} {
      allow read: if isSignedIn();
    }
  }
}
